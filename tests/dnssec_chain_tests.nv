// dnssec_chain_tests.nv — the validation of a chain of keys from a trust
// anchor to a signed answer, and the four states of RFC 4033 section 5.
//
// The zones are made by `tests/make_chain_vectors.py`, a signer that shares
// no code with the package: it builds the canonical form of RFC 4034
// section 6 itself and signs with the `cryptography` package.  The chain is
//
//   .            DNSKEY 257 3 15   Ed25519, the key the trust anchor names
//   example.     DNSKEY 257 3 13   ECDSA P-256, its DS in the root signed by the root key
//   sub.example. DNSKEY 257 3 8    RSA-2048 with SHA-256, its DS signed by the example key
//
// and the answers are www.sub.example. A, a wildcard expansion of
// *.sub.example. TXT at a.b.sub.example., and an MX whose exchange has
// capital letters.  All signatures are valid from 1700000000 to
// 1702592000; the tests use 1701000000 unless they say otherwise.  The RSA
// key is generated afresh by every run of the script, so the vectors below
// are one run's output and its key tag, 40727, belongs to that run.

use std.test
use std.bytes
use std.str
use dns_codec
use dnsrr
use dnskey
use dnsrrsig
use dnsvalid

// The bytes of hexadecimal text.
fn hexb(text: Str) -> [u8]
    bytes.to_byte_list(bytes.from_hex(text) ?? bytes.zeros(0))

// A name from presentation text.
fn nm(text: Str) -> dns_codec.DnsName
    dnsrr.name_text(text)

// A record of the given owner, type, TTL and RDATA in hexadecimal.
fn rec(owner: Str, rtype: Int, ttl: Int, rdata_hex: Str) -> dnsrr.DnsRr
    dnsrr.rr(nm(owner), rtype, 1, ttl, hexb(rdata_hex))

// An RRSIG record of the given owner covering a type, the RDATA in hexadecimal.
fn sigrec(owner: Str, rdata_hex: Str) -> dnsrr.DnsRr
    dnsrr.rr(nm(owner), 46, 1, 3600, hexb(rdata_hex))

// The DS record the trust anchor is.
fn anchor() -> dnskey.Ds
    match dnskey.ds_parse(hexb(v_root_anchor_ds()))
        Ok(d)  => d
        Err(_) => dnskey.Ds { key_tag: 0, algorithm: 0, digest_type: 0, digest: [] }

// The three links of the chain.
fn link_root() -> dnsvalid.ZoneLink
    dnsvalid.ZoneLink { zone: nm("."),
        dnskeys: [rec(".", 48, 3600, v_root_dnskey())],
        dnskey_sigs: [sigrec(".", v_root_dnskey_sig())],
        ds: [],
        ds_sigs: [],
        ds_absent: false }

fn link_example() -> dnsvalid.ZoneLink
    dnsvalid.ZoneLink { zone: nm("example."),
        dnskeys: [rec("example.", 48, 3600, v_ex_dnskey())],
        dnskey_sigs: [sigrec("example.", v_ex_dnskey_sig())],
        ds: [rec("example.", 43, 3600, v_ex_ds())],
        ds_sigs: [sigrec("example.", v_ex_ds_sig())],
        ds_absent: false }

fn link_sub() -> dnsvalid.ZoneLink
    dnsvalid.ZoneLink { zone: nm("sub.example."),
        dnskeys: [rec("sub.example.", 48, 3600, v_sub_dnskey())],
        dnskey_sigs: [sigrec("sub.example.", v_sub_dnskey_sig())],
        ds: [rec("sub.example.", 43, 3600, v_sub_ds())],
        ds_sigs: [sigrec("sub.example.", v_sub_ds_sig())],
        ds_absent: false }

fn chain() -> [dnsvalid.ZoneLink]
    [link_root(), link_example(), link_sub()]

// The answers.
fn www_a() -> dnsrr.DnsRr
    rec("www.sub.example.", 1, 300, v_www_a())

fn www_sig() -> dnsrr.DnsRr
    sigrec("www.sub.example.", v_www_a_sig())

fn wild_txt() -> dnsrr.DnsRr
    rec("a.b.sub.example.", 16, 300, v_wild_txt())

fn wild_sig() -> dnsrr.DnsRr
    sigrec("a.b.sub.example.", v_wild_txt_sig())

fn mx_shown() -> dnsrr.DnsRr
    rec("MX.Sub.EXAMPLE.", 15, 300, v_mx_shown())

fn mx_sig() -> dnsrr.DnsRr
    sigrec("mx.sub.example.", v_mx_sig())

// ── The chain ───────────────────────────────────────────────────────

@test
fn test_a_chain_from_the_trust_anchor_is_secure_and_gives_the_zone_keys() [io]
    let v = dnsvalid.validate_chain([anchor()], chain(), 1701000000)
    test.assert_eq(v.state, dnsvalid.STATE_SECURE)
    test.assert_eq(v.reason, dnsvalid.REASON_NONE)
    test.assert_eq(dns_codec.name_text(v.zone), "sub.example.")
    test.assert_eq(list.len(v.keys), 1)
    test.assert_eq(v.keys[0].algorithm, 8)
    test.assert_eq(dnskey.key_tag(dnskey.dnskey_rdata(v.keys[0])), 40727)
    test.case("the root alone is secure too, with the root's keys")
    let r = dnsvalid.validate_chain([anchor()], [link_root()], 1701000000)
    test.assert_eq(r.state, dnsvalid.STATE_SECURE)
    test.assert_eq(r.keys[0].algorithm, 15)
    test.assert_eq(dnskey.key_tag(dnskey.dnskey_rdata(r.keys[0])), 36560)
    test.case("and so is the chain down to example.")
    test.assert_eq(dnsvalid.validate_chain([anchor()], [link_root(), link_example()], 1701000000).state,
        dnsvalid.STATE_SECURE)

@test
fn test_answers_are_authenticated_through_the_chain() [io]
    let now = 1701000000
    test.case("www.sub.example. A")
    let a = dnsvalid.validate_answer([anchor()], chain(), [www_a()], [www_sig()], now)
    test.assert_eq(a.state, dnsvalid.STATE_SECURE)
    test.assert_eq(a.reason, dnsvalid.REASON_NONE)
    test.case("a wildcard expansion: the signature covers *.sub.example. and its Labels field is 2")
    test.assert_eq(dnsvalid.validate_answer([anchor()], chain(), [wild_txt()], [wild_sig()], now).state,
        dnsvalid.STATE_SECURE)
    test.case("an MX whose owner and exchange have capital letters")
    test.assert_eq(dnsvalid.validate_answer([anchor()], chain(), [mx_shown()], [mx_sig()], now).state,
        dnsvalid.STATE_SECURE)
    test.case("the keys of the zone check the RRset directly")
    let keys = dnsvalid.validate_chain([anchor()], chain(), now).keys
    test.assert_eq(dnsvalid.validate_rrset(keys, [www_a()], [www_sig()], now).state, dnsvalid.STATE_SECURE)

@test
fn test_the_validity_period_is_enforced_at_every_link_and_at_the_answer() [io]
    test.case("one second before the inception and one after the expiration")
    let early = dnsvalid.validate_answer([anchor()], chain(), [www_a()], [www_sig()], 1699999999)
    test.assert_eq(early.state, dnsvalid.STATE_BOGUS)
    test.assert_eq(early.detail, dnsrrsig.VERDICT_NOT_YET_VALID)
    let late = dnsvalid.validate_answer([anchor()], chain(), [www_a()], [www_sig()], 1702592001)
    test.assert_eq(late.state, dnsvalid.STATE_BOGUS)
    test.assert_eq(late.detail, dnsrrsig.VERDICT_EXPIRED)
    test.case("both ends are inside")
    test.assert_eq(dnsvalid.validate_answer([anchor()], chain(), [www_a()], [www_sig()], 1700000000).state,
        dnsvalid.STATE_SECURE)
    test.assert_eq(dnsvalid.validate_answer([anchor()], chain(), [www_a()], [www_sig()], 1702592000).state,
        dnsvalid.STATE_SECURE)

@test
fn test_a_changed_answer_is_bogus() [io]
    let now = 1701000000
    let changed = rec("www.sub.example.", 1, 300, "c0000202")
    let v = dnsvalid.validate_answer([anchor()], chain(), [changed], [www_sig()], now)
    test.assert_eq(v.state, dnsvalid.STATE_BOGUS)
    test.assert_eq(v.reason, dnsvalid.REASON_SIGNATURE_FAILED)
    test.assert_eq(v.detail, dnsrrsig.VERDICT_SIGNATURE)
    test.case("no signature at all in a secure zone")
    let none = dnsvalid.validate_answer([anchor()], chain(), [www_a()], [], now)
    test.assert_eq(none.state, dnsvalid.STATE_BOGUS)
    test.assert_eq(none.reason, dnsvalid.REASON_NO_SIGNATURE)
    test.case("a signature over another type")
    let other = dnsvalid.validate_answer([anchor()], chain(), [www_a()], [wild_sig()], now)
    test.assert_eq(other.state, dnsvalid.STATE_BOGUS)
    test.assert_eq(other.reason, dnsvalid.REASON_NO_SIGNATURE)
    test.case("a signature of the right type for another name")
    let moved = dnsvalid.validate_answer([anchor()], chain(), [rec("ftp.sub.example.", 1, 300, "c0000201")], [www_sig()], now)
    test.assert_eq(moved.state, dnsvalid.STATE_BOGUS)

@test
fn test_a_signature_by_the_wrong_zone_is_bogus_and_an_answer_outside_it_is_indeterminate() [io]
    let now = 1701000000
    test.case("the answer's signer is example., but the chain ends at sub.example.")
    let up = dnsvalid.validate_answer([anchor()], [link_root(), link_example()], [www_a()], [www_sig()], now)
    test.assert_eq(up.state, dnsvalid.STATE_BOGUS)
    test.assert_eq(up.reason, dnsvalid.REASON_WRONG_SIGNER)
    test.case("an answer that is not under the zone the chain ends at")
    let out = dnsvalid.validate_answer([anchor()], chain(), [rec("www.other.example.", 1, 300, "c0000201")], [www_sig()], now)
    test.assert_eq(out.state, dnsvalid.STATE_INDETERMINATE)
    test.assert_eq(out.reason, dnsvalid.REASON_NO_CHAIN)
    test.case("an empty RRset")
    test.assert_eq(dnsvalid.validate_answer([anchor()], chain(), [], [www_sig()], now).state,
        dnsvalid.STATE_INDETERMINATE)
    test.assert_eq(dnsvalid.validate_rrset([], [], [www_sig()], now).state, dnsvalid.STATE_INDETERMINATE)

@test
fn test_a_signature_made_with_an_algorithm_that_is_not_verified_is_indeterminate() [io]
    let keys = dnsvalid.validate_chain([anchor()], chain(), 1701000000).keys
    // The same RRSIG with its algorithm byte changed to 10 (RSA/SHA-512).
    var rd = hexb(v_www_a_sig())
    rd[2] = 10 as u8
    let s = dnsrr.rr(nm("www.sub.example."), 46, 1, 3600, rd)
    let v = dnsvalid.validate_rrset(keys, [www_a()], [s], 1701000000)
    test.assert_eq(v.state, dnsvalid.STATE_INDETERMINATE)
    test.assert_eq(v.reason, dnsvalid.REASON_ALGORITHM)
    test.case("a signature with an unknown key tag is bogus, as the zone's keys are all known")
    var rd2 = hexb(v_www_a_sig())
    rd2[17] = (rd2[17] as Int ^ 1) as u8
    let t = dnsrr.rr(nm("www.sub.example."), 46, 1, 3600, rd2)
    let w = dnsvalid.validate_rrset(keys, [www_a()], [t], 1701000000)
    test.assert_eq(w.state, dnsvalid.STATE_BOGUS)
    test.assert_eq(w.reason, dnsvalid.REASON_SIGNATURE_FAILED)
    test.assert_eq(w.detail, dnsrrsig.VERDICT_KEY_MISMATCH)
    test.case("a malformed RRSIG record is ignored, and then there is no signature")
    let junk = dnsrr.rr(nm("www.sub.example."), 46, 1, 3600, [0 as u8, 1 as u8, 2 as u8])
    test.assert_eq(dnsvalid.validate_rrset(keys, [www_a()], [junk], 1701000000).reason,
        dnsvalid.REASON_NO_SIGNATURE)

// ── What breaks a chain ─────────────────────────────────────────────

@test
fn test_a_chain_with_no_anchor_or_no_link_is_indeterminate() [io]
    let none = dnsvalid.validate_chain([], chain(), 1701000000)
    test.assert_eq(none.state, dnsvalid.STATE_INDETERMINATE)
    test.assert_eq(none.reason, dnsvalid.REASON_NO_ANCHOR)
    let empty = dnsvalid.validate_chain([anchor()], [], 1701000000)
    test.assert_eq(empty.state, dnsvalid.STATE_INDETERMINATE)
    test.assert_eq(empty.reason, dnsvalid.REASON_NO_CHAIN)

@test
fn test_an_anchor_that_names_no_key_of_the_root_is_bogus() [io]
    let wrong = dnskey.Ds { key_tag: anchor().key_tag,
        algorithm: 15,
        digest_type: 2,
        digest: hexb("00".repeat(32)) }
    let v = dnsvalid.validate_chain([wrong], chain(), 1701000000)
    test.assert_eq(v.state, dnsvalid.STATE_BOGUS)
    test.assert_eq(v.reason, dnsvalid.REASON_NO_KEY_FOR_DS)
    test.case("the real root anchor does not name the generated key either")
    test.assert_eq(dnsvalid.validate_chain([dnsvalid.root_trust_anchor()], chain(), 1701000000).state,
        dnsvalid.STATE_BOGUS)

@test
fn test_anchors_this_package_cannot_use_leave_the_zone_insecure() [io]
    let bad_alg = dnskey.Ds { key_tag: 1, algorithm: 10, digest_type: 2, digest: hexb("00".repeat(32)) }
    let gost = dnskey.Ds { key_tag: 1, algorithm: 8, digest_type: 3, digest: hexb("00".repeat(32)) }
    test.assert_eq(dnsvalid.validate_chain([bad_alg], chain(), 1701000000).state, dnsvalid.STATE_INSECURE)
    test.assert_eq(dnsvalid.validate_chain([gost], chain(), 1701000000).reason, dnsvalid.REASON_UNSUPPORTED)
    test.case("one usable anchor among them is enough")
    test.assert_eq(dnsvalid.validate_chain([bad_alg, anchor(), gost], chain(), 1701000000).state,
        dnsvalid.STATE_SECURE)

@test
fn test_a_dnskey_rrset_that_the_ds_key_did_not_sign_is_bogus() [io]
    test.case("no signature over the DNSKEY RRset")
    var l0 = link_root()
    l0 = dnsvalid.ZoneLink { zone: l0.zone,
        dnskeys: l0.dnskeys,
        dnskey_sigs: [],
        ds: [],
        ds_sigs: [],
        ds_absent: false }
    let a = dnsvalid.validate_chain([anchor()], [l0], 1701000000)
    test.assert_eq(a.state, dnsvalid.STATE_BOGUS)
    test.assert_eq(a.reason, dnsvalid.REASON_DNSKEY_NOT_SIGNED)
    test.case("the root's signature on example.'s DNSKEY RRset")
    let le = link_example()
    let b = dnsvalid.validate_chain([anchor()], [link_root(), dnsvalid.ZoneLink { zone: le.zone,
        dnskeys: le.dnskeys,
        dnskey_sigs: [sigrec("example.", v_ex_ds_sig())],
        ds: le.ds,
        ds_sigs: le.ds_sigs,
        ds_absent: false }],
    1701000000)
    test.assert_eq(b.state, dnsvalid.STATE_BOGUS)
    test.assert_eq(b.reason, dnsvalid.REASON_DNSKEY_NOT_SIGNED)

@test
fn test_a_ds_rrset_the_parent_did_not_sign_is_bogus() [io]
    let ls = link_sub()
    test.case("the DS changed after it was signed")
    let flipped = dnsrr.rr(nm("sub.example."), 43, 1, 3600, dnsrr.cat(hexb("0000"), list.slice(hexb(v_sub_ds()), 2, 36)))
    let a = dnsvalid.validate_chain([anchor()], [link_root(), link_example(), dnsvalid.ZoneLink { zone: ls.zone,
        dnskeys: ls.dnskeys,
        dnskey_sigs: ls.dnskey_sigs,
        ds: [flipped],
        ds_sigs: ls.ds_sigs,
        ds_absent: false }],
    1701000000)
    test.assert_eq(a.state, dnsvalid.STATE_BOGUS)
    test.assert_eq(a.reason, dnsvalid.REASON_DS_NOT_SIGNED)
    test.case("no signature over the DS")
    let b = dnsvalid.validate_chain([anchor()], [link_root(), link_example(), dnsvalid.ZoneLink { zone: ls.zone,
        dnskeys: ls.dnskeys,
        dnskey_sigs: ls.dnskey_sigs,
        ds: ls.ds,
        ds_sigs: [],
        ds_absent: false }],
    1701000000)
    test.assert_eq(b.state, dnsvalid.STATE_BOGUS)
    test.assert_eq(b.reason, dnsvalid.REASON_DS_NOT_SIGNED)
    test.case("the DS signed by the wrong zone's key: the example key signed it, the root's signature on it is another zone's")
    let c = dnsvalid.validate_chain([anchor()], [link_root(), dnsvalid.ZoneLink { zone: ls.zone,
        dnskeys: ls.dnskeys,
        dnskey_sigs: ls.dnskey_sigs,
        ds: ls.ds,
        ds_sigs: ls.ds_sigs,
        ds_absent: false }],
    1701000000)
    test.assert_eq(c.state, dnsvalid.STATE_BOGUS)
    test.assert_eq(c.reason, dnsvalid.REASON_DS_NOT_SIGNED)

@test
fn test_a_dnskey_that_no_ds_names_is_bogus() [io]
    let ls = link_sub()
    // sub.example.'s links with example.'s DNSKEY in place of its own.
    let swapped = dnsvalid.ZoneLink { zone: ls.zone,
        dnskeys: [rec("sub.example.", 48, 3600, v_ex_dnskey())],
        dnskey_sigs: ls.dnskey_sigs,
        ds: ls.ds,
        ds_sigs: ls.ds_sigs,
        ds_absent: false }
    let v = dnsvalid.validate_chain([anchor()], [link_root(), link_example(), swapped], 1701000000)
    test.assert_eq(v.state, dnsvalid.STATE_BOGUS)
    test.assert_eq(v.reason, dnsvalid.REASON_NO_KEY_FOR_DS)
    test.case("a record in the DNSKEY RRset that is not a DNSKEY is not a key")
    let notkey = dnsvalid.ZoneLink { zone: ls.zone,
        dnskeys: [rec("sub.example.", 16, 3600, "0161")],
        dnskey_sigs: ls.dnskey_sigs,
        ds: ls.ds,
        ds_sigs: ls.ds_sigs,
        ds_absent: false }
    test.assert_eq(dnsvalid.validate_chain([anchor()], [link_root(), link_example(), notkey], 1701000000).reason,
        dnsvalid.REASON_NO_KEY_FOR_DS)
    test.case("a DNSKEY record that does not parse is dropped")
    let junk = dnsvalid.ZoneLink { zone: ls.zone,
        dnskeys: [rec("sub.example.", 48, 3600, "0101"), rec("sub.example.", 48, 3600, v_sub_dnskey())],
        dnskey_sigs: ls.dnskey_sigs,
        ds: ls.ds,
        ds_sigs: ls.ds_sigs,
        ds_absent: false }
    test.assert_eq(dnsvalid.validate_chain([anchor()], [link_root(), link_example(), junk], 1701000000).reason,
        dnsvalid.REASON_DNSKEY_NOT_SIGNED)

@test
fn test_a_missing_ds_is_indeterminate_unless_its_absence_is_proved() [io]
    let ls = link_sub()
    let missing = dnsvalid.ZoneLink { zone: ls.zone,
        dnskeys: ls.dnskeys,
        dnskey_sigs: ls.dnskey_sigs,
        ds: [],
        ds_sigs: [],
        ds_absent: false }
    let v = dnsvalid.validate_chain([anchor()], [link_root(), link_example(), missing], 1701000000)
    test.assert_eq(v.state, dnsvalid.STATE_INDETERMINATE)
    test.assert_eq(v.reason, dnsvalid.REASON_NO_DS)
    test.case("a proof that there is no DS makes the zone insecure")
    let absent = dnsvalid.ZoneLink { zone: ls.zone,
        dnskeys: [],
        dnskey_sigs: [],
        ds: [],
        ds_sigs: [],
        ds_absent: true }
    let w = dnsvalid.validate_chain([anchor()], [link_root(), link_example(), absent], 1701000000)
    test.assert_eq(w.state, dnsvalid.STATE_INSECURE)
    test.assert_eq(w.reason, dnsvalid.REASON_DS_ABSENT)
    test.assert_eq(dns_codec.name_text(w.zone), "sub.example.")

@test
fn test_zones_out_of_order_are_bogus() [io]
    let v = dnsvalid.validate_chain([anchor()], [link_root(), link_example(), link_sub(), link_example()], 1701000000)
    test.assert_eq(v.state, dnsvalid.STATE_BOGUS)
    test.assert_eq(v.reason, dnsvalid.REASON_OUT_OF_ORDER)
    test.case("a zone that is not below the one before")
    let other = dnsvalid.ZoneLink { zone: nm("other."),
        dnskeys: [],
        dnskey_sigs: [],
        ds: [],
        ds_sigs: [],
        ds_absent: false }
    test.assert_eq(dnsvalid.validate_chain([anchor()], [link_root(), link_example(), other], 1701000000).reason,
        dnsvalid.REASON_OUT_OF_ORDER)
    test.case("the same zone twice")
    test.assert_eq(dnsvalid.validate_chain([anchor()], [link_root(), link_example(), link_example()], 1701000000).reason,
        dnsvalid.REASON_OUT_OF_ORDER)

// ── DS records this package cannot use (RFC 6840 section 5.2) ───────

// A link for sub.example. whose DS RRset is `ds` with the signature `sig`.
fn sub_with_ds(ds: [dnsrr.DnsRr], sig: dnsrr.DnsRr) -> dnsvalid.ZoneLink
    let ls = link_sub()
    dnsvalid.ZoneLink { zone: ls.zone,
        dnskeys: ls.dnskeys,
        dnskey_sigs: ls.dnskey_sigs,
        ds: ds,
        ds_sigs: [sig],
        ds_absent: false }

@test
fn test_a_ds_of_an_unsupported_algorithm_or_digest_makes_the_zone_insecure() [io]
    test.case("a DS that names algorithm 10")
    let a = dnsvalid.validate_chain([anchor()], [link_root(), link_example(), sub_with_ds([rec("sub.example.", 43, 3600, v_sub_ds_bad_alg())],
        sigrec("sub.example.", v_sub_ds_bad_alg_sig()))],
    1701000000)
    test.assert_eq(a.state, dnsvalid.STATE_INSECURE)
    test.assert_eq(a.reason, dnsvalid.REASON_UNSUPPORTED)
    test.case("a DS whose digest type is 3, GOST, which is not computed")
    let b = dnsvalid.validate_chain([anchor()], [link_root(),
        link_example(),
        sub_with_ds([rec("sub.example.", 43, 3600, v_sub_ds_gost())], sigrec("sub.example.", v_sub_ds_gost_sig()))],
    1701000000)
    test.assert_eq(b.state, dnsvalid.STATE_INSECURE)
    test.case("an unsupported DS beside a supported one: the supported one is used")
    let c = dnsvalid.validate_chain([anchor()], [link_root(), link_example(), sub_with_ds([rec("sub.example.", 43, 3600, v_sub_ds()), rec("sub.example.", 43, 3600, v_sub_ds_bad_alg())],
        sigrec("sub.example.", v_sub_ds_mixed_sig()))],
    1701000000)
    test.assert_eq(c.state, dnsvalid.STATE_SECURE)

// ── Keys the package refuses ────────────────────────────────────────

@test
fn test_an_rsa_key_of_1024_bits_is_refused_and_the_signature_is_bogus() [io]
    // short.example.'s 1024-bit RSA key, below the 2048 bits rsa-nv accepts.
    let short_rd = hexb(v_short_dnskey())
    match dnskey.dnskey_parse(short_rd)
        Err(_) => test.assert_eq(true, false)
        Ok(k)  =>
            let sig = hexb(v_short_sig())
            match dnsrrsig.rrsig_parse(sig)
                Err(_) => test.assert_eq(true, false)
                Ok(s)  =>
                    let a = dnsrr.rr(nm("www.short.example."), 1, 1, 300, hexb("c0000201"))
                    test.assert_eq(dnsrrsig.verify(k, s, [a], 1701000000), dnsrrsig.VERDICT_KEY_REFUSED)
                    let v = dnsvalid.validate_rrset([k], [a], [dnsrr.rr(nm("www.short.example."), 46, 1, 3600, sig)], 1701000000)
                    test.assert_eq(v.state, dnsvalid.STATE_BOGUS)
                    test.assert_eq(v.detail, dnsrrsig.VERDICT_KEY_REFUSED)

@test
fn test_the_words_for_states_and_reasons() [io]
    test.assert_eq(dnsvalid.state_name(0), "secure")
    test.assert_eq(dnsvalid.state_name(1), "insecure")
    test.assert_eq(dnsvalid.state_name(2), "bogus")
    test.assert_eq(dnsvalid.state_name(3), "indeterminate")
    test.assert_eq(dnsvalid.state_name(4), "unknown")
    test.assert_eq(dnsvalid.reason_name(0), "authenticated")
    test.assert_eq(dnsvalid.reason_name(1), "the chain does not reach the answer")
    test.assert_eq(dnsvalid.reason_name(2), "a zone is not below the zone before it")
    test.assert_eq(dnsvalid.reason_name(3), "no trust anchor was given")
    test.assert_eq(dnsvalid.reason_name(4), "no DS record was supplied")
    test.assert_eq(dnsvalid.reason_name(5), "the parent proved there is no DS record")
    test.assert_eq(dnsvalid.reason_name(6), "no DS record names a supported algorithm and digest")
    test.assert_eq(dnsvalid.reason_name(7), "the DS RRset is not signed by the parent")
    test.assert_eq(dnsvalid.reason_name(8), "no DNSKEY is named by a DS record")
    test.assert_eq(dnsvalid.reason_name(9), "the DNSKEY RRset is not signed by a key a DS record names")
    test.assert_eq(dnsvalid.reason_name(10), "the RRset has no signature")
    test.assert_eq(dnsvalid.reason_name(11), "no signature of the RRset verifies")
    test.assert_eq(dnsvalid.reason_name(12), "the signatures use an algorithm that is not supported")
    test.assert_eq(dnsvalid.reason_name(13), "the signer is not the zone the chain ends at")
    test.assert_eq(dnsvalid.reason_name(99), "unknown")

// ── Records the key set leaves out ──────────────────────────────────

@test
fn test_keys_without_the_zone_bit_revoked_keys_and_junk_are_not_in_the_key_set() [io]
    // example.'s DNSKEY RRset holds its key and four records that are not
    // usable: flags 1, flags 385 (zone key and revoked), protocol 4, and two
    // bytes.  The whole RRset is signed by the example. key.
    let le = link_example()
    let extra = dnsvalid.ZoneLink { zone: le.zone, dnskeys: [rec("example.", 48, 3600, v_ex_dnskey()),
        rec("example.", 48, 3600, v_ex_nz_dnskey()),
        rec("example.", 48, 3600, v_ex_rv_dnskey()),
        rec("example.", 48, 3600, v_ex_p4_dnskey()),
        rec("example.", 48, 3600, v_ex_short_dnskey())],
    dnskey_sigs: [sigrec("example.", v_ex_dnskey_extra_sig())], ds: le.ds, ds_sigs: le.ds_sigs, ds_absent: false }
    let v = dnsvalid.validate_chain([anchor()], [link_root(), extra], 1701000000)
    test.assert_eq(v.state, dnsvalid.STATE_SECURE)
    test.assert_eq(list.len(v.keys), 1)
    test.assert_eq(v.keys[0].flags, 257)

@test
fn test_a_ds_rrset_may_hold_a_record_that_is_not_a_ds() [io]
    let v = dnsvalid.validate_chain([anchor()], [link_root(), link_example(), sub_with_ds([rec("sub.example.", 43, 3600, v_sub_ds()), rec("sub.example.", 43, 3600, v_sub_ds_junk())],
        sigrec("sub.example.", v_sub_ds_junk_sig()))],
    1701000000)
    test.assert_eq(v.state, dnsvalid.STATE_SECURE)

