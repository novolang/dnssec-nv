// ── Signer and entry keys ───────────────────────────────────────────

// An A record at www.example. signed by the example. key with the signer
// name ".", made by tests/make_chain_vectors.py.  The key tag and the
// algorithm are the example. key's, so the signature verifies against it.
fn v_ex_www_a_root_signer_sig() -> Str
    "00010d020000012c657b7e006553f1000dc0004bae1285aeee1c8d038838f849" + "cfd2951d9bdfdebbef689bd584bb3e4f629e7415ff81a3598d3a289e4aa15afe" + "a25d944d99d96970b617fe67b99548a6b42b47"

@test
fn test_a_signature_that_verifies_but_names_another_signer_is_bogus() [io]
    let now = 1701000000
    let www = rec("www.example.", 1, 300, "c0000201")
    let sig = sigrec("www.example.", v_ex_www_a_root_signer_sig())
    test.case("the signature itself is good: the example. key checks it")
    let keys = dnsvalid.validate_chain([anchor()], [link_root(), link_example()], now).keys
    test.assert_eq(dnsvalid.validate_rrset(keys, [www], [sig], now).state, dnsvalid.STATE_SECURE)
    test.case("but its signer is the root, and the chain ends at example.")
    let v = dnsvalid.validate_answer([anchor()], [link_root(), link_example()], [www], [sig], now)
    test.assert_eq(v.state, dnsvalid.STATE_BOGUS)
    test.assert_eq(v.reason, dnsvalid.REASON_WRONG_SIGNER)

@test
fn test_a_ds_that_names_a_revoked_key_or_one_without_the_zone_bit_names_no_key() [io]
    let now = 1701000000
    test.case("a revoked key")
    let revoked = hexb(v_ex_rv_dnskey())
    let link_rv = dnsvalid.ZoneLink { zone: nm("example."),
        dnskeys: [rec("example.", 48, 3600, v_ex_rv_dnskey())],
        dnskey_sigs: [],
        ds: [],
        ds_sigs: [],
        ds_absent: false }
    let v1 = dnsvalid.validate_chain([dnskey.ds_of_dnskey(nm("example."), revoked, 2)], [link_rv], now)
    test.assert_eq(v1.state, dnsvalid.STATE_BOGUS)
    test.assert_eq(v1.reason, dnsvalid.REASON_NO_KEY_FOR_DS)
    test.case("a key without the zone bit")
    let plain = hexb(v_ex_nz_dnskey())
    let link_nz = dnsvalid.ZoneLink { zone: nm("example."),
        dnskeys: [rec("example.", 48, 3600, v_ex_nz_dnskey())],
        dnskey_sigs: [],
        ds: [],
        ds_sigs: [],
        ds_absent: false }
    let v2 = dnsvalid.validate_chain([dnskey.ds_of_dnskey(nm("example."), plain, 2)], [link_nz], now)
    test.assert_eq(v2.state, dnsvalid.STATE_BOGUS)
    test.assert_eq(v2.reason, dnsvalid.REASON_NO_KEY_FOR_DS)
